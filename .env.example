# Copy to .env before starting anything: cp .env.example .env
#
# Compose reads this file automatically. Variables written as ${VAR?Variable not
# set} in compose.yml have no default on purpose — a missing value should stop
# the stack rather than quietly start it with a guess.

# --- Database ---------------------------------------------------------------
# Used both to start PostgreSQL and to build the URL the API connects with.
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# Host port the development database is published on (compose.override.yml).
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
API_PORT=8000
GUNICORN_WORKERS=4

# Image name and tag used by `docker compose build`.
DOCKER_IMAGE_API=payment-platform-api
TAG=latest

# --- Running the app or the tests on the host, outside Docker ----------------
# In the containers these are derived from POSTGRES_* above and point at `db`.
# These two point at the published port instead, for `make run` and `make test`.
FLASK_APP=wsgi:app
FLASK_DEBUG=1
DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5432/payments

# Must be a throwaway database: the test suite drops and rebuilds its schema.
TEST_DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5432/payments_test

# --- Dev helpers ------------------------------------------------------------
ADMINER_PORT=8081
