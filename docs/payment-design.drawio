        </mxCell>
        <mxCell id="p3-b2" value="unique violation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5E7E8;strokeColor=#93343C;fontColor=#93343C;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="p3-1">
          <mxGeometry x="710" y="360" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3-b3" value="409 · A's payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6764;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p3-1">
          <mxGeometry x="920" y="360" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3-eb1" style="endArrow=block;endFill=1;html=1;strokeColor=#131917;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p3-1" source="p3-b1" target="p3-b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-eb2" style="endArrow=block;endFill=1;html=1;strokeColor=#131917;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p3-1" source="p3-b2" target="p3-b3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-ebad" value="insert refused" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#93343C;fontColor=#93343C;fontFamily=Courier New;fontSize=11;labelBackgroundColor=none;align=left;exitX=0.5;exitY=0;entryX=0.57;entryY=1;" edge="1" parent="p3-1" source="p3-b2" target="p3-idx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p3-time" value="time →" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Courier New;fontSize=11;fontColor=#5C6764;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="440" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p3-foot" value="If B carried the SAME Idempotency-Key as A, the service catches the same IntegrityError and returns 200 with A's payment instead of 409.&lt;br&gt;The branch lives in the error handler, not in a pre-check — a SELECT before the INSERT is not serialized with it." style="text;html=1;strokeColor=#B9C1BD;fillColor=#FFFFFF;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#5C6764;spacingLeft=10;" vertex="1" parent="p3-1">
