        </mxCell>

        <mxCell id="p3-eok" value="claims the cart" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#2C6E49;fontColor=#2C6E49;fontFamily=Courier New;fontSize=11;labelBackgroundColor=none;align=left;exitX=0.25;exitY=1;entryX=0.24;entryY=0;" edge="1" parent="p3-1" source="p3-a2" target="p3-idx">
