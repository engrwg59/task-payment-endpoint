        </mxCell>
        <mxCell id="p2-e2" value="provider declined" style="endArrow=block;endFill=1;html=1;strokeColor=#93343C;fontColor=#93343C;fontFamily=Courier New;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="p2-1" source="p2-pending" target="p2-bad">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

