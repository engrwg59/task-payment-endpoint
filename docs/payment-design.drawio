        <mxCell id="p3-ea1" style="endArrow=block;endFill=1;html=1;strokeColor=#131917;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p3-1" source="p3-a1" target="p3-a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-ea2" style="endArrow=block;endFill=1;html=1;strokeColor=#131917;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p3-1" source="p3-a2" target="p3-a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-ea3" style="endArrow=block;endFill=1;html=1;strokeColor=#131917;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p3-1" source="p3-a3" target="p3-a4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3-idx" value="uq_payments_active_cart&lt;br&gt;UNIQUE (cart_id) WHERE status IN ('pending','succeeded')&lt;br&gt;&lt;br&gt;one live payment per cart — enforced by the database, not by the code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EEF4;strokeColor=#1B4F7A;fontColor=#1B4F7A;align=left;spacingLeft=16;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p3-1">
