          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p2-legend" value="double outline = terminal state, never transitions again" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontFamily=Courier New;fontSize=11;fontColor=#5C6764;" vertex="1" parent="p2-1">
