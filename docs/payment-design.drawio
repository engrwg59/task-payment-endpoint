          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p2-e1" value="provider authorized" style="endArrow=block;endFill=1;html=1;strokeColor=#2C6E49;fontColor=#2C6E49;fontFamily=Courier New;fontSize=11;labelBackgroundColor=none;verticalAlign=bottom;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="p2-1" source="p2-pending" target="p2-ok">
