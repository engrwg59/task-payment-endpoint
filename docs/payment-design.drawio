        <mxCell id="p1-note" value="The provider call sits BETWEEN two committed transactions, never inside one.&lt;br&gt;Everything before the call is undoable. Everything after it records something that already happened." style="text;html=1;strokeColor=#B9C1BD;fillColor=#FFFFFF;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontColor=#5C6764;spacingLeft=10;" vertex="1" parent="p1-1">
